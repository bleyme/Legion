; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Legion"
config/description="Arène de combat 2D : jetpacks, armes à gogo, bots et multijoueur local"
run/main_scene="res://scenes/menu/menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"
SoundManager="*res://scripts/sound_manager.gd"
WeaponData="*res://scripts/weapon_data.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

2d/default_gravity=1500.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
